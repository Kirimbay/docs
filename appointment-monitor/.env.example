# Скопируйте в .env и заполните своими данными
# cp .env.example .env

# Обязательно: полис ОМС (только цифры) и дата рождения ДД.ММ.ГГГГ
OMS_NUMBER=5040200838017611
OMS_BIRTHDAY=01.12.2000

# Что мониторить (узнайте через: python monitor.py departments / hospitals / doctors)
DEPARTMENT_ID=
LPU_CODE=
# Опционально: конкретный врач (короткий или полный id)
DOCTOR_ID=

# Сколько дней вперёд смотреть (обычно 14–21)
DAYS=21

# Интервал проверки в секундах (300 = 5 минут)
CHECK_INTERVAL_SEC=300

# Telegram-уведомления (создайте бота у @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ссылка для быстрой записи в оповещении
BOOKING_URL=https://zdrav.mosreg.ru/
