# Обязательно: Telegram-уведомления
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ресторан на TableCheck
SHOP_SLUG=centara-mirage-beach-resort-dubai-uno-mas
BOOKING_URL=https://www.tablecheck.com/en/shops/centara-mirage-beach-resort-dubai-uno-mas/reserve

# Состав гостей (макс. для Uno Mas = 6)
NUM_ADULTS=4
NUM_CHILDREN=2
NUM_SENIORS=0
NUM_BABIES=0

# Сколько дней вперёд проверять (окно брони Uno Mas ≈ 24 часа)
DAYS=2

# Интервал опроса в секундах (900 = 15 минут)
CHECK_INTERVAL_SEC=900

# Необязательно: фильтр по времени суток, например dinner или lunch
# lunch = до 16:00 Dubai, dinner = с 16:00, all = всё
MEAL_FILTER=all

# Часовой пояс ресторана
TIMEZONE=Asia/Dubai

# Минимум часов до слота (у Uno Mas бронь закрывается за 5 часов)
MIN_HOURS_BEFORE=5
