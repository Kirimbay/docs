{
  "log": {
    "loglevel": "warning"
  },
  "dns": {
    "servers": [
      "localhost"
    ],
    "queryStrategy": "UseIPv4"
  },
  "inbounds": [
    {
      "tag": "ENTRY_XHTTP_REALITY",
      "listen": "0.0.0.0",
      "port": 443,
      "protocol": "vless",
      "settings": {
        "clients": [],
        "decryption": "none"
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "reality",
        "xhttpSettings": {
          "path": "/__XHTTP_PATH__",
          "mode": "stream-one",
          "extra": {
            "xPaddingBytes": "100-1000"
          }
        },
        "realitySettings": {
          "show": false,
          "xver": 0,
          "target": "127.0.0.1:9443",
          "serverNames": [
            "__NODE_DOMAIN__"
          ],
          "privateKey": "__REALITY_PRIVATE_KEY__",
          "shortIds": [
            "__SHORT_ID_1__",
            "__SHORT_ID_2__"
          ]
        }
      }
    }
  ],
  "outbounds": [
    {
      "tag": "EXIT_WARP",
      "protocol": "wireguard",
      "settings": {
        "secretKey": "__WARP_PRIVATE_KEY__",
        "address": [
          "__WARP_ADDRESS_V4__/32"
        ],
        "peers": [
          {
            "publicKey": "bmXOC+F1FxEMF9dyiK2H5/1SUtzH0JuVo51h2wPfgyo=",
            "allowedIPs": [
              "0.0.0.0/0"
            ],
            "endpoint": "engage.cloudflareclient.com:2408"
          }
        ],
        "mtu": 1280,
        "domainStrategy": "ForceIPv4"
      }
    },
    {
      "tag": "BLOCK",
      "protocol": "blackhole"
    }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "type": "field",
        "inboundTag": [
          "ENTRY_XHTTP_REALITY"
        ],
        "ip": [
          "geoip:private"
        ],
        "outboundTag": "BLOCK"
      },
      {
        "type": "field",
        "inboundTag": [
          "ENTRY_XHTTP_REALITY"
        ],
        "protocol": [
          "bittorrent"
        ],
        "outboundTag": "BLOCK"
      },
      {
        "type": "field",
        "inboundTag": [
          "ENTRY_XHTTP_REALITY"
        ],
        "network": "tcp,udp",
        "outboundTag": "EXIT_WARP"
      }
    ]
  }
}
